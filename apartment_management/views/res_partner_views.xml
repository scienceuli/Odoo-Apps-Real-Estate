<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_apartment" model="ir.ui.view">
        <field name="name">res.partner.form.apartment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_apartments" type="object" class="oe_stat_button"
                        icon="fa-building-o" invisible="not apartment_count">
                    <field name="apartment_count" widget="statinfo" string="Wohnungen"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
